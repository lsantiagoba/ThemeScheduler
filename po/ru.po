msgid "Theme Scheduler"
msgstr "Планировщик тем"
msgid "Automatically switch between GNOME's light and dark themes at your chosen times"
msgstr "Автоматическое переключение между светлой и тёмной темами GNOME в выбранное время"
msgid "Schedule"
msgstr "Расписание"
msgid "Theme schedule"
msgstr "Расписание темы"
msgid "Times use your computer’s local clock and the 24-hour format."
msgstr "Время указывается по местным часам компьютера в 24-часовом формате."
msgid "Light theme starts"
msgstr "Начало светлой темы"
msgid "Dark theme starts"
msgstr "Начало тёмной темы"
msgid "Changes are automatic"
msgstr "Изменения применяются автоматически"
msgid "The current theme is updated as soon as you change either time."
msgstr "Текущая тема обновляется сразу после изменения любого времени."
msgid "About"
msgstr "О приложении"
msgid "Support development"
msgstr "Поддержать разработку"
msgid "If Theme Scheduler helps you, consider making a donation."
msgstr "Если Планировщик тем вам помогает, рассмотрите возможность пожертвования."
msgid "Donate"
msgstr "Пожертвовать"
msgid "Source code"
msgstr "Исходный код"
